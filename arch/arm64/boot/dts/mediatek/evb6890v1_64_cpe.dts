			pinmux = <PINMUX_GPIO70__FUNC_PCIE_PERESET_N_1P>,
			         <PINMUX_GPIO71__FUNC_PCIE_WAKE_N_1P>,
				 <PINMUX_GPIO72__FUNC_PCIE_CLKREQ_N_1P>;
