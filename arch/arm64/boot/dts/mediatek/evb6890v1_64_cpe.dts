/*<!-- BEGIN: fibocom modified-->  */
&spi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* AW1000 Ultra vendor hardware: ProSLIC is physically on SPI0 CS0. */
	proslic_spi: proslic_spi@0 {
		compatible = "silabs,proslic_spi";
		reg = <0>;
		spi-max-frequency = <24000000>;
		spi-cpha = <1>;
		spi-cpol = <1>;
		channel_count = <1>;
		debug_level = <7>;
		slic_interrupt = <&pio 24 0>;
		reset_gpio = <&pio 23 0>;
		ig,enable-spi = <1>;
	};
};
/*<!-- END: fibocom modified-->  */


&spi3 {
	status = "okay";
	#address-cells=<1>;
	#size-cells=<0>;
};

/*begin: modify audio codec function,by laizhenhao,2021.05.31*/
&i2c0 {
	status = "okay";
	#address-cells=<1>;
	#size-cells=<0>;

	nau88c22: nau88c22@1a {
		compatible = "nuvoton,nau88c22";
		reg = <0x1a>;
	};

};
/*end: modify audio codec function,by laizhenhao,2021.05.31*/

/* GPS GPIO standardization start */
#if 1
&pio {

	eth_gpio_default: mdio_default {
		mux {
			pinmux = <PINMUX_GPIO61__FUNC_GPIO61>;
		};
	};

	eth_smi_mdio_pinctl: eth_smi_mdio_pinctl {
		mux {
			pinmux = <PINMUX_GPIO61__FUNC_SMI_MDIO>;
		};
	};

	eth_smi_mdc_pinctl: eth_smi_mdc_pinctl {
		mux {
			pinmux = <PINMUX_GPIO62__FUNC_SMI_MDC>;
		};
	};

