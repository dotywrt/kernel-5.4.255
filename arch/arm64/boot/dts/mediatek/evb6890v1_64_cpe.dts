			pinmux = <PINMUX_GPIO142__FUNC_GPIO142>;
			bias-pull-up;     
		};
	};
	
	rf_set_pin_1st_pulldown_default: rf_set_pin_1st_pulldown-config {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO142__FUNC_GPIO142>;
			bias-pull-down;     
		};
	};
	
	rf_set_pin_2nd_pullup_default: rf_set_pin_2nd_pullup-config {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO143__FUNC_GPIO143>;
			bias-pull-up;     
		};
	};
	
	rf_set_pin_2nd_pulldown_default: rf_set_pin_2nd_pulldown-config {
		pins_cmd_dat {
