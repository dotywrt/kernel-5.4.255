// Begin: FG360 boot time management, Add by Shuai Liu, 2021.06.11
&pmic {
	mt6330-led {
		compatible = "mediatek,mt6330_leds";
		Isink1 {
			reg = <1>;
			label = "led9515:green:cellular-radio";
			linux,default-trigger = "none";
			default-state = "off";
		};
	};
};
// End: FG360 boot time management, Add by Shuai Liu, 2021.06.11

&gpio_leds {
	led0 {
		label = "gpio4_LED_INTERNET";
		gpios = <&pio 4 GPIO_ACTIVE_HIGH>;
		linux,default-trigger = "none";
		default-state = "off";
	};
	led1 {
		label = "gpio5_LED_WIFI_G";
		gpios = <&pio 5 GPIO_ACTIVE_HIGH>;
		linux,default-trigger = "none";
		default-state = "off";
	};
	led2 {
		label = "gpio8_LED_SYS_G";
		gpios = <&pio 8 GPIO_ACTIVE_HIGH>;
		linux,default-trigger = "timer";
		default-state = "on";
	};
	led3 {
		label = "gpio21_LED_FXS_G";
		gpios = <&pio 21 GPIO_ACTIVE_HIGH>;
		linux,default-trigger = "none";
		default-state = "off";
	};
	led4 {
		label = "gpio22_LED_5G_G";
		gpios = <&pio 22 GPIO_ACTIVE_HIGH>;
		linux,default-trigger = "none";
		default-state = "off";
	};
	led5 {
		label = "gpio25_LED_MOBILE_R";
		gpios = <&pio 25 GPIO_ACTIVE_HIGH>;
		linux,default-trigger = "none";
		default-state = "off";
	};
	led6 {
		label = "gpio26_LED_FXS_R";
		gpios = <&pio 26 GPIO_ACTIVE_HIGH>;
		linux,default-trigger = "none";
		default-state = "off";
	};
	led7 {
		label = "gpio27_LED_MOBILE_G";
		gpios = <&pio 27 GPIO_ACTIVE_HIGH>;
		linux,default-trigger = "none";
		default-state = "off";
	};
	led8 {
		label = "gpio28_LED_SYS_R";
		gpios = <&pio 28 GPIO_ACTIVE_HIGH>;
		linux,default-trigger = "none";
		default-state = "off";
	};
	led9 {
		label = "gpio29_LED_WIFI_R";
		gpios = <&pio 29 GPIO_ACTIVE_HIGH>;
		linux,default-trigger = "none";
		default-state = "off";
	};
};

/*begin: add for RST WPS button by laizhenhao,2021.3.27*/

/* DOTY-AW1000-STAGE3-BUTTON-PINCTRL-BEGIN */
&pio {
	arc_btn_pin: arc_btn_pin {
		pins_cmd_dat {
			pinmux = <0x700 0xa00 0x1400>;
			mediatek,pull-up-adv = <0x65>;
			pull-up;
			input-enable;
		};
	};
};
/* DOTY-AW1000-STAGE3-BUTTON-PINCTRL-END */

&gpio_keys {
	pinctrl-names = "default";
	pinctrl-0 = <&arc_btn_pin>;

	/delete-node/ button0;
	/delete-node/ button1;

	btn_reset {
		label = "reset";
		gpios = <&pio 7 GPIO_ACTIVE_LOW>;
		linux,code = <408>;
	};
	btn_wlan {
		label = "wlan";
		gpios = <&pio 10 GPIO_ACTIVE_LOW>;
		linux,code = <238>;
	};
	btn_wps {
		label = "wps";
		gpios = <&pio 20 GPIO_ACTIVE_LOW>;
		linux,code = <529>;
	};
};
/*end: add for RST WPS button by laizhenhao,2021.3.27*/

#include <mediatek/evb6890v1_64_cpe/cust.dtsi>
/*End of this file, DO NOT ADD ANYTHING HERE*/

/* DOTY-LK-VENDOR-DTB-PARITY-BEGIN */
/*
 * Exact semantic closure against vendor lk_main_dtb.
 * Main LK binary is not modified here.
 */

/ {
	/delete-node/ pwrap@1000d000;

};

&i2c0 {
	/delete-property/ status;
	/delete-node/ nau88c22@1a;
};

&spi3 {
	/delete-property/ status;
	/delete-property/ #address-cells;
	/delete-property/ #size-cells;
};
/* DOTY-LK-VENDOR-DTB-PARITY-END */

/* DOTY-LK-VENDOR-PHANDLE-PARITY-BEGIN */
