/* BEGIN: support realtek eth phy,modify by haowei.cheng*/
&eth {
	pinctrl-names = "eth_gpio_default",
		"eth_smi_mdio_pinctl",
		"eth_smi_mdc_pinctl";
	pinctrl-0 = <&eth_gpio_default>;
	pinctrl-1 = <&eth_smi_mdio_pinctl>;
	pinctrl-2 = <&eth_smi_mdc_pinctl>;
	status = "okay";
	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		fg360,phy_name = "aqr112c";
		reg = <0>;
		phy-mode = "sgmii";
		phy-handle = <&phy8>;
	};
	gmac1: mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		fg360,phy_name = "mt7531AE";
		phy-mode = "sgmii";
		fixed-link {
			speed = <1000>;
			full-duplex;
			pause;
		};
	};
	gmac3: mac@3 {
		compatible = "mediatek,eth-mac";
		fg360,phy_name = "rtl8221b";
		reg = <0>;
		phy-mode = "sgmii";
		phy-handle = <&phy7>;
	};
	gmac4: mac@4 {
		compatible = "mediatek,eth-mac";
		fg360,phy_name = "rtl8211fs";
		reg = <1>;
		phy-mode = "sgmii";
		phy-handle = <&phy3>;
	};
	gmac5: mac@5 {
		compatible = "mediatek,eth-mac_def";
		fg360,phy_name = "MAC0";
		reg = <0>;
		phy-mode = "sgmii";
		fixed-link {
			speed = <1000>;
			full-duplex;
			pause;
		};
	};
	gmac6: mac@6 {
		compatible = "mediatek,eth-mac_def";
		fg360,phy_name = "MAC1";
		reg = <1>;
		phy-mode = "sgmii";
		fixed-link {
			speed = <1000>;
			full-duplex;
			pause;
		};
	};

	mdio: mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;
		phy1reset-gpios = <&pio 66 0>;
		phy2reset-gpios = <&pio 64 0>;
		/* RTL8221B - vendor DTB address */
		phy7: phy@7 {
			reg = <7>;
			phy-mode = "sgmii";
			compatible = "ethernet-phy-ieee802.3-c22";
		};
		//RTL8211FS
		phy3: phy@3 {
			reg = <3>;
			phy-mode = "sgmii";
			compatible = "ethernet-phy-ieee802.3-c22";
		};
		//AQR112C
		phy8: phy@8 {
			reg = <8>;
			phy-mode = "sgmii";
			compatible = "ethernet-phy-ieee802.3-c45";
		};
		//MT7531
		phy31: phy@31 {
			reg = <31>;
			phy-mode = "sgmii";
			compatible = "ethernet-phy-ieee802.3-c22";
		};
	};
};
/* END: support realtek eth phy,modify by haowei.cheng*/


&gsw {
	mediatek,mdio = <&mdio>;
	mediatek,mdio_master_pinmux = <0>;
	reset-gpios = <&pio 66 0>;
	interrupt-parent = <&pio>;
	interrupts = <65 IRQ_TYPE_LEVEL_HIGH>;

	status = "okay";

	port6: port@6 {
		compatible = "mediatek,mt753x-port";
		reg = <6>;
		phy-mode = "sgmii";
		fixed-link {
			speed = <2500>;
			full-duplex;
		};
	};
};

&pcie0 {
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_pins_default>;
	status = "okay";
};

&pcie1 {
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_pins_default>;
	status = "okay";
};

&pcie2 {
	max-link-speed = <3>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie2_pins_default>;
	status = "okay";
};

&pcie3 {
	max-link-speed = <3>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie3_pins_default>;
	status = "okay";
};

